# SMTP settings for the email notifier. Copy to .env and fill in.
# .env is gitignored -- never commit real credentials.
#
# Load before running, e.g.:   set -a; . ./.env; set +a

SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=alerts@example.com
SMTP_PASSWORD=

# Transport security. Defaults: SMTP_SSL=false, SMTP_STARTTLS=true (port 587).
# For implicit TLS on port 465 set SMTP_SSL=true.
SMTP_SSL=false
SMTP_STARTTLS=true
SMTP_TIMEOUT=30

ALERT_FROM=alerts@example.com
# Comma-separated for multiple recipients.
ALERT_TO=you@example.com

# --- optional: zone transfer ---------------------------------------------------
# Only needed if you enable the zone backend (zone.enabled + zone.acknowledge_terms
# in rules.yaml). Request a TSIG key from Switch: https://www.switch.ch/open-data/
# Leave unset otherwise.
SWITCH_ZONE_TSIG_NAME=
SWITCH_ZONE_TSIG_KEY=
SWITCH_ZONE_TSIG_ALGORITHM=hmac-sha512
